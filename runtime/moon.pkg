import {
  "bobzhang/typify/serde_json",
  "bobzhang/typify/collections",
  "bobzhang/typify/regex",
  "moonbitlang/core/encoding/utf8",
}

// Codecs share uniform signatures (`raise SerError`) so that generated code
// can pass them as function values, even where they cannot fail.

warnings = "-unused_error_type"
