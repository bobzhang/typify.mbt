    "active_lock_reason",
    @typify_rt.ser_option(
      self.active_lock_reason,
      PullRequestActiveLockReason::serialize,
    ),
  )
  o.field("additions", @typify_rt.ser_i64(self.additions))
  o.field("assignee", @typify_rt.ser_option(self.assignee, User::serialize))
  o.field("assignees", @typify_rt.ser_vec(self.assignees, User::serialize))
  o.field(
    "author_association",
    AuthorAssociation::serialize(self.author_association),
  )
  o.field("auto_merge", @typify_rt.ser_unit())
  o.field("base", PullRequestBase::serialize(self.base))
  o.field(
    "body",
    @typify_rt.ser_option(self.body, (v : String) => @typify_rt.ser_string(v)),
  )
  o.field("changed_files", @typify_rt.ser_i64(self.changed_files))
  o.field(
    "closed_at",
    @typify_rt.ser_option(self.closed_at, @typify_rt.DateTimeUtc::serialize),
  )
  o.field("comments", @typify_rt.ser_i64(self.comments))
  o.field("comments_url", @typify_rt.ser_string(self.comments_url))
  o.field("commits", @typify_rt.ser_i64(self.commits))
  o.field("commits_url", @typify_rt.ser_string(self.commits_url))
  o.field("created_at", @typify_rt.DateTimeUtc::serialize(self.created_at))
  o.field("deletions", @typify_rt.ser_i64(self.deletions))
  o.field("diff_url", @typify_rt.ser_string(self.diff_url))
  o.field("draft", @typify_rt.ser_bool(self.draft))
  o.field("head", PullRequestHead::serialize(self.head))
  o.field("html_url", @typify_rt.ser_string(self.html_url))
  o.field("id", @typify_rt.ser_i64(self.id))
  o.field("issue_url", @typify_rt.ser_string(self.issue_url))
  o.field("labels", @typify_rt.ser_vec(self.labels, Label::serialize))
  o.field("_links", PullRequestLinks::serialize(self.links))
  o.field("locked", @typify_rt.ser_bool(self.locked))
  o.field(
    "maintainer_can_modify",
    @typify_rt.ser_bool(self.maintainer_can_modify),
  )
  o.field(
    "merge_commit_sha",
    @typify_rt.ser_option(self.merge_commit_sha, (v : String) => {
      @typify_rt.ser_string(v)
    }),
  )
  o.field(
    "mergeable",
    @typify_rt.ser_option(self.mergeable, (v : Bool) => @typify_rt.ser_bool(v)),
  )
  o.field("mergeable_state", @typify_rt.ser_string(self.mergeable_state))
  o.field(
    "merged",
    @typify_rt.ser_option(self.merged, (v : Bool) => @typify_rt.ser_bool(v)),
  )
  o.field(
    "merged_at",
    @typify_rt.ser_option(self.merged_at, @typify_rt.DateTimeUtc::serialize),
  )
  o.field("merged_by", @typify_rt.ser_option(self.merged_by, User::serialize))
  o.field(
    "milestone",
    @typify_rt.ser_option(self.milestone, Milestone::serialize),
  )
  o.field("node_id", @typify_rt.ser_string(self.node_id))
  o.field("number", @typify_rt.ser_i64(self.number))
  o.field("patch_url", @typify_rt.ser_string(self.patch_url))
  o.field(
    "rebaseable",
    @typify_rt.ser_option(self.rebaseable, (v : Bool) => @typify_rt.ser_bool(v)),
  )
  o.field(
    "requested_reviewers",
    @typify_rt.ser_vec(
      self.requested_reviewers,
      PullRequestRequestedReviewersItem::serialize,
    ),
  )
  o.field(
    "requested_teams",
    @typify_rt.ser_vec(self.requested_teams, Team::serialize),
  )
  o.field("review_comment_url", @typify_rt.ser_string(self.review_comment_url))
  o.field("review_comments", @typify_rt.ser_i64(self.review_comments))
  o.field(
    "review_comments_url",
    @typify_rt.ser_string(self.review_comments_url),
  )
  o.field("state", PullRequestState::serialize(self.state))
  o.field("statuses_url", @typify_rt.ser_string(self.statuses_url))
  o.field("title", @typify_rt.ser_string(self.title))
  o.field("updated_at", @typify_rt.DateTimeUtc::serialize(self.updated_at))
  o.field("url", @typify_rt.ser_string(self.url))
  o.field("user", User::serialize(self.user))

  o.build()
}

///|
/// Decode from JSON text, like `serde_json::from_str`.
pub fn PullRequest::from_json_str(
  text : StringView,
) -> PullRequest raise @typify_rt.DeError {
  PullRequest::deserialize(@typify_rt.De::from_str(text))
}

///|
/// Encode as compact JSON text, like `serde_json::to_string`.
pub fn PullRequest::to_json_string(
  self : PullRequest,
) -> String raise @typify_rt.SerError {
  @typify_rt.to_json_string(self.serialize())
}

///|
/// Decode from a builtin `Json` value (duplicate keys and number
/// lexemes are not representable in `Json`; prefer `from_json_str`).
pub fn PullRequest::from_json(
  json : Json,
) -> PullRequest raise @typify_rt.DeError {
  PullRequest::deserialize(@typify_rt.De::from_json(json))
}

///|
pub impl ToJson for PullRequest with fn to_json(self) {
  @typify_rt.content_to_json(self.serialize()) catch {
    e => abort("PullRequest::to_json: \{e}")
  }
}

///|
/// The [comment](https://docs.github.com/en/rest/reference/pulls#comments) itself.
