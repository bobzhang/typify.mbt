///|
pub fn RepositoryPrivatizedRepository::serialize(
  self : RepositoryPrivatizedRepository,
) -> @typify_rt.Content raise @typify_rt.SerError {
  let o = @typify_rt.ObjectBuilder::new()
  o.field("allow_auto_merge", @typify_rt.ser_bool(self.allow_auto_merge))
  if self.allow_forking is Some(_) {
    o.field(
      "allow_forking",
      @typify_rt.ser_option(self.allow_forking, (v : Bool) => {
        @typify_rt.ser_bool(v)
      }),
    )
  }
  o.field("allow_merge_commit", @typify_rt.ser_bool(self.allow_merge_commit))
  o.field("allow_rebase_merge", @typify_rt.ser_bool(self.allow_rebase_merge))
  o.field("allow_squash_merge", @typify_rt.ser_bool(self.allow_squash_merge))
  o.field("archive_url", @typify_rt.ser_string(self.archive_url))
  o.field("archived", @typify_rt.ser_bool(self.archived))
  o.field("assignees_url", @typify_rt.ser_string(self.assignees_url))
  o.field("blobs_url", @typify_rt.ser_string(self.blobs_url))
  o.field("branches_url", @typify_rt.ser_string(self.branches_url))
  o.field("clone_url", @typify_rt.ser_string(self.clone_url))
  o.field("collaborators_url", @typify_rt.ser_string(self.collaborators_url))
  o.field("comments_url", @typify_rt.ser_string(self.comments_url))
  o.field("commits_url", @typify_rt.ser_string(self.commits_url))
