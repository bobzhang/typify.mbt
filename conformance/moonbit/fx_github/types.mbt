  o.field("hooks_url", @typify_rt.ser_string(self.hooks_url))
  o.field("html_url", @typify_rt.ser_string(self.html_url))
  o.field("id", @typify_rt.ser_i64(self.id))
  o.field("issue_comment_url", @typify_rt.ser_string(self.issue_comment_url))
  o.field("issue_events_url", @typify_rt.ser_string(self.issue_events_url))
  o.field("issues_url", @typify_rt.ser_string(self.issues_url))
  o.field("keys_url", @typify_rt.ser_string(self.keys_url))
