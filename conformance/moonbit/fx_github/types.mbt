  o.field("languages_url", @typify_rt.ser_string(self.languages_url))
  o.field("license", @typify_rt.ser_option(self.license, License::serialize))
  if self.master_branch is Some(_) {
    o.field(
      "master_branch",
      @typify_rt.ser_option(self.master_branch, (v : String) => {
        @typify_rt.ser_string(v)
      }),
    )
  }
  o.field("merges_url", @typify_rt.ser_string(self.merges_url))
  o.field("milestones_url", @typify_rt.ser_string(self.milestones_url))
  o.field(
    "mirror_url",
    @typify_rt.ser_option(self.mirror_url, (v : String) => {
      @typify_rt.ser_string(v)
    }),
  )
  o.field("name", @typify_rt.ser_string(self.name))
  o.field("node_id", @typify_rt.ser_string(self.node_id))
  o.field("notifications_url", @typify_rt.ser_string(self.notifications_url))
  o.field("open_issues", @typify_rt.ser_i64(self.open_issues))
  o.field("open_issues_count", @typify_rt.ser_i64(self.open_issues_count))
  if self.organization is Some(_) {
    o.field(
      "organization",
      @typify_rt.ser_option(self.organization, (v : String) => {
        @typify_rt.ser_string(v)
      }),
    )
  }
  o.field("owner", User::serialize(self.owner))
  if self.permissions is Some(_) {
    o.field(
      "permissions",
      @typify_rt.ser_option(self.permissions, RepositoryPermissions::serialize),
    )
  }
  o.field("private", @typify_rt.ser_bool(self.private))
  if self.public is Some(_) {
    o.field(
      "public",
      @typify_rt.ser_option(self.public, (v : Bool) => @typify_rt.ser_bool(v)),
    )
  }
  o.field("pulls_url", @typify_rt.ser_string(self.pulls_url))
  o.field("pushed_at", RepositoryPushedAt::serialize(self.pushed_at))
  o.field("releases_url", @typify_rt.ser_string(self.releases_url))
  o.field("size", @typify_rt.ser_i64(self.size))
  o.field("ssh_url", @typify_rt.ser_string(self.ssh_url))
  if self.stargazers is Some(_) {
    o.field(
      "stargazers",
      @typify_rt.ser_option(self.stargazers, (v : Int64) => {
        @typify_rt.ser_i64(v)
      }),
    )
  }
  o.field("stargazers_count", @typify_rt.ser_i64(self.stargazers_count))
  o.field("stargazers_url", @typify_rt.ser_string(self.stargazers_url))
  o.field("statuses_url", @typify_rt.ser_string(self.statuses_url))
  o.field("subscribers_url", @typify_rt.ser_string(self.subscribers_url))
  o.field("subscription_url", @typify_rt.ser_string(self.subscription_url))
  o.field("svn_url", @typify_rt.ser_string(self.svn_url))
  o.field("tags_url", @typify_rt.ser_string(self.tags_url))
  o.field("teams_url", @typify_rt.ser_string(self.teams_url))
  o.field("trees_url", @typify_rt.ser_string(self.trees_url))
  o.field("updated_at", @typify_rt.DateTimeUtc::serialize(self.updated_at))
  o.field("url", @typify_rt.ser_string(self.url))
  o.field("watchers", @typify_rt.ser_i64(self.watchers))
  o.field("watchers_count", @typify_rt.ser_i64(self.watchers_count))

  o.build()
}

