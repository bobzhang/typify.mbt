  o.field("archived", @typify_rt.ser_bool(self.archived))
  o.field("assignees_url", @typify_rt.ser_string(self.assignees_url))
  o.field("blobs_url", @typify_rt.ser_string(self.blobs_url))
  o.field("branches_url", @typify_rt.ser_string(self.branches_url))
  o.field("clone_url", @typify_rt.ser_string(self.clone_url))
  o.field("collaborators_url", @typify_rt.ser_string(self.collaborators_url))
  o.field("comments_url", @typify_rt.ser_string(self.comments_url))
  o.field("commits_url", @typify_rt.ser_string(self.commits_url))
  o.field("compare_url", @typify_rt.ser_string(self.compare_url))
  o.field("contents_url", @typify_rt.ser_string(self.contents_url))
  o.field("contributors_url", @typify_rt.ser_string(self.contributors_url))
  o.field("created_at", RepositoryCreatedAt::serialize(self.created_at))
  o.field("default_branch", @typify_rt.ser_string(self.default_branch))
  o.field(
    "delete_branch_on_merge",
    @typify_rt.ser_bool(self.delete_branch_on_merge),
  )
  o.field("deployments_url", @typify_rt.ser_string(self.deployments_url))
  o.field(
    "description",
    @typify_rt.ser_option(self.description, (v : String) => {
      @typify_rt.ser_string(v)
    }),
  )
  if self.disabled is Some(_) {
    o.field(
      "disabled",
      @typify_rt.ser_option(self.disabled, (v : Bool) => @typify_rt.ser_bool(v)),
    )
  }
  o.field("downloads_url", @typify_rt.ser_string(self.downloads_url))
  o.field("events_url", @typify_rt.ser_string(self.events_url))
  o.field("fork", @typify_rt.ser_bool(self.fork))
  o.field("forks", @typify_rt.ser_i64(self.forks))
  o.field("forks_count", @typify_rt.ser_i64(self.forks_count))
  o.field("forks_url", @typify_rt.ser_string(self.forks_url))
  o.field("full_name", @typify_rt.ser_string(self.full_name))
