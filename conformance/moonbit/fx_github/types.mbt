///|
pub fn Repository::serialize(
  self : Repository,
) -> @typify_rt.Content raise @typify_rt.SerError {
  let o = @typify_rt.ObjectBuilder::new()
  o.field("allow_auto_merge", @typify_rt.ser_bool(self.allow_auto_merge))
  if self.allow_forking is Some(_) {
    o.field(
      "allow_forking",
      @typify_rt.ser_option(self.allow_forking, (v : Bool) => {
        @typify_rt.ser_bool(v)
      }),
    )
  }
  o.field("allow_merge_commit", @typify_rt.ser_bool(self.allow_merge_commit))
  o.field("allow_rebase_merge", @typify_rt.ser_bool(self.allow_rebase_merge))
  o.field("allow_squash_merge", @typify_rt.ser_bool(self.allow_squash_merge))
