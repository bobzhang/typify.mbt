// Generates the MoonBit side of the conformance harness: one package per
// fixture (with the same settings as upstream's tests) and a dispatcher.

///|
fn read(path : String) -> String {
  @fs.read_file_to_string(path) catch {
    e => abort("read \{path}: \{Repr(e)}")
  }
}

///|
fn schemas_settings(
  settings : @typify.TypeSpaceSettings,
) -> @typify.TypeSpaceSettings {
  guard (try? @serde_json.parse("{\"enum\": [1, \"one\"]}")) is Ok(Object(o)) else {
    abort("bad schema")
  }
  let conv = try! @schema.decode_schema_object(o)
  settings
  .with_replacement("HandGeneratedType", "String", [Display])
  .with_patch(
    "TypeThatNeedsMoreDerives",
    @typify.TypeSpacePatch::new()
    .with_rename("TypeThatHasMoreDerives")
    .with_derive("Eq")
    .with_derive("PartialEq"),
  )
  .with_conversion(conv, "serde_json::Value", [Display])
  .with_crate("std", Version(try! @semver.Version::parse("1.0.0")))
  .with_struct_builder(true)
}

///|
fn fixtures() -> Array[(String, String, @typify.TypeSpaceSettings, Bool)] {
  let names = [
    "arrays-and-tuples", "deny-list", "extraneous-enum", "flatten-default", "id-or-name",
    "maps", "merged-schemas", "more_types", "multiple-instance-types", "noisy-types",
    "property-pattern", "reflexive", "rust-collisions", "simple-types", "string-enum-with-default",
    "type-with-modified-generation", "types-with-defaults", "types-with-more-impls",
    "untyped-enum-with-null", "various-enums", "x-rust-type",
  ]
  let out = names.map(n => {
    (
      n,
      "tests/upstream/schemas/\{n}.json",
      schemas_settings(@typify.TypeSpaceSettings::default()),
      false,
    )
  })
  out.push(
    (
      "maps_custom",
      "tests/upstream/schemas/maps.json",
      schemas_settings(
        @typify.TypeSpaceSettings::default().with_map_type(
          "std::collections::BTreeMap",
        ),
      ),
      false,
    ),
  )
  // vega: compile-only (its conversion/replacement types are user-supplied,
  // so there is no Rust harness for it).
  let my_enum = @schema.RootSchema::from_json_str(
    "{\"enum\":[null,\"normal\",\"bold\",\"lighter\",\"bolder\",\"100\",\"200\",\"300\",\"400\",\"500\",\"600\",\"700\",\"800\",\"900\",100,200,300,400,500,600,700,800,900]}",
  ) catch {
    e => abort("vega conversion: \{e}")
  }
  out.push(
    (
      "vega",
      "tests/upstream/impl/vega.json",
      @typify.TypeSpaceSettings::default()
      .with_conversion(my_enum.schema, "MyEnum", [FromStr])
      .with_replacement("ColorValue", "ColorValue", []),
      true,
    ),
  )
  out.push(
    (
      "github",
      "tests/upstream/impl/github.json",
      @typify.TypeSpaceSettings::default(),
      true,
    ),
  )
  out
}

///|
fn package_name(name : String) -> String {
  "fx_" + name.replace_all(old="-", new="_")
}

///|
fn main {
  let dispatch = StringBuilder()
  dispatch.write_string(
    "// Code generated by conformance/codegen; DO NOT EDIT.\n\n///|\nfn dispatch(schema : String, ty : String, input : String) -> String {\n  match (schema, ty) {\n",
  )
  let imports = []
  for f in fixtures() {
    let (name, path, settings, everything) = f
    let root = @schema.RootSchema::from_json_str(read(path)) catch {
      e => abort("\{name}: \{e}")
    }
    let root = if everything {
      let metadata = root.schema.metadata.unwrap_or(@schema.Metadata::default())
      {
        ..root,
        schema: {
          ..root.schema,
          metadata: Some({ ..metadata, title: Some("Everything"), }),
        },
      }
    } else {
      root
    }
    let space = @typify.TypeSpace::new(settings)
    ignore(space.add_root_schema(root) catch { e => abort("\{name}: \{e}") })
    let code = @moonbit.generate(space)
    let pkg = package_name(name)
    let dir = "conformance/moonbit/\{pkg}"
    @fs.create_dir(dir) catch {
      _ => ()
    }
    @fs.write_string_to_file("\{dir}/types.mbt", code) catch {
      e => abort("write: \{Repr(e)}")
    }
    @fs.write_string_to_file(
      "\{dir}/moon.pkg",
      "import {\n  \"bobzhang/typify/runtime\" @typify_rt,\n}\n\nwarnings = \"-unused_value\"\n",
    ) catch {
      e => abort("write: \{Repr(e)}")
    }
    imports.push("  \"bobzhang/typify/conformance/moonbit/\{pkg}\",")
    for pair in space.entries() {
      let rust_name = match pair.1.details {
        Struct(d) => Some(d.name)
        Enum(d) => Some(d.name)
        Newtype(d) => Some(d.name)
        _ => None
      }
      guard rust_name is Some(rust_name) && name != "vega" else { continue }
      let mbt_name = @moonbit.type_name_of(space, pair.0)
      dispatch.write_string(
        "    (\"\{name}\", \"\{rust_name}\") => run(input, @\{pkg}.\{mbt_name}::from_json_str, @\{pkg}.\{mbt_name}::to_json_string)\n",
      )
    }
  }
  dispatch.write_string("    _ => \"NOTYPE\"\n  }\n}\n")
  @fs.write_string_to_file(
    "conformance/moonbit/dispatch.mbt",
    dispatch.to_string(),
  ) catch {
    e => abort("write: \{Repr(e)}")
  }
  @fs.write_string_to_file(
    "conformance/moonbit/moon.pkg",
    "import {\n  \"bobzhang/typify/runtime\" @typify_rt,\n  \"moonbitlang/x/fs\",\n\{imports.join("\n")}\n}\n",
  ) catch {
    e => abort("write: \{Repr(e)}")
  }
}
