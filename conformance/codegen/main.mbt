// Generates the MoonBit side of the conformance harness: one package per
// fixture (with the same settings as upstream's tests) and a dispatcher.

///|
fn read(path : String) -> String {
  @fs.read_file_to_string(path) catch {
    e => abort("read \{path}: \{Repr(e)}")
  }
}

///|
fn schemas_settings(
  settings : @typify.TypeSpaceSettings,
) -> @typify.TypeSpaceSettings {
  let parsed = @serde_json.parse("{\"enum\": [1, \"one\"]}") catch {
    _ => abort("bad schema")
  }
  guard parsed is Object(o) else { abort("bad schema") }
  let conv = try! @schema.decode_schema_object(o)
  settings
  .with_replacement("HandGeneratedType", "String", [Display])
  .with_patch(
    "TypeThatNeedsMoreDerives",
    @typify.TypeSpacePatch::new()
    .with_rename("TypeThatHasMoreDerives")
    .with_derive("Eq")
    .with_derive("PartialEq"),
  )
  .with_conversion(conv, "serde_json::Value", [Display])
  .with_crate("std", Version(try! @semver.Version::parse("1.0.0")))
  .with_struct_builder(true)
}

///|
fn fixtures() -> Array[(String, String, @typify.TypeSpaceSettings, Bool)] {
  let names = [
    "arrays-and-tuples", "deny-list", "extraneous-enum", "flatten-default", "id-or-name",
    "maps", "merged-schemas", "more_types", "multiple-instance-types", "noisy-types",
    "property-pattern", "reflexive", "rust-collisions", "simple-types", "string-enum-with-default",
    "type-with-modified-generation", "types-with-defaults", "types-with-more-impls",
    "untyped-enum-with-null", "various-enums", "x-rust-type",
  ]
  let out = names.map(n => {
    (
      n,
      "tests/upstream/schemas/\{n}.json",
      schemas_settings(@typify.TypeSpaceSettings::default()),
      false,
    )
  })
  out.push(
    (
      "maps_custom",
      "tests/upstream/schemas/maps.json",
      schemas_settings(
        @typify.TypeSpaceSettings::default().with_map_type(
          "std::collections::BTreeMap",
        ),
      ),
      false,
    ),
  )
  // vega: compile-only (its conversion/replacement types are user-supplied,
  // so there is no Rust harness for it).
  let my_enum = @schema.RootSchema::from_json_str(
    "{\"enum\":[null,\"normal\",\"bold\",\"lighter\",\"bolder\",\"100\",\"200\",\"300\",\"400\",\"500\",\"600\",\"700\",\"800\",\"900\",100,200,300,400,500,600,700,800,900]}",
  ) catch {
    e => abort("vega conversion: \{e}")
  }
  out.push(
    (
      "vega",
      "tests/upstream/impl/vega.json",
      @typify.TypeSpaceSettings::default()
      .with_conversion(my_enum.schema, "MyEnum", [FromStr])
      .with_replacement("ColorValue", "ColorValue", []),
      true,
    ),
  )
  out.push(
    (
      "github",
      "tests/upstream/impl/github.json",
      @typify.TypeSpaceSettings::default(),
      true,
    ),
  )
  out
}

///|
fn package_name(name : String) -> String {
  "fx_" + name.replace_all(old="-", new="_")
}

///|
fn write(path : String, text : String) -> Unit {
  @fs.write_string_to_file(path, text) catch {
    e => abort("write \{path}: \{Repr(e)}")
  }
}

///|
/// Generate one MoonBit package per schema under `base` (import path
/// `bobzhang/typify/<base>/<pkg>`), plus `base/dispatch.mbt` and
/// `base/moon.pkg`. `compile_only` schemas get no dispatch entries.
fn generate_suite(
  base : String,
  suite : Array[(String, @schema.RootSchema, @typify.TypeSpaceSettings, Bool)],
) -> Unit {
  let dispatch = StringBuilder()
  dispatch.write_string(
    "// Code generated by conformance/codegen; DO NOT EDIT.\n\n///|\nfn dispatch(schema : String, ty : String, input : String) -> String {\n  match (schema, ty) {\n",
  )
  let imports = []
  for f in suite {
    let (name, root, settings, compile_only) = f
    let space = @typify.TypeSpace::new(settings)
    ignore(space.add_root_schema(root) catch { e => abort("\{name}: \{e}") })
    // `strict` (CONFORMANCE_STRICT=1): strict-warning, FromJson output, to
    // check that those options only change how the code is written.
    let code = if strict_mode() {
      let options = @moonbit.Options::default()
      options.strict_warnings = true
      options.from_json = true
      @moonbit.generate_with(space, options) catch {
        e => abort("\{name}: \{e}")
      }
    } else {
      @moonbit.generate(space)
    }
    let pkg = package_name(name)
    let dir = "\{base}/\{pkg}"
    @fs.create_dir(dir) catch {
      _ => ()
    }
    write("\{dir}/types.mbt", code)
    write(
      "\{dir}/moon.pkg",
      "import {\n  \"bobzhang/typify/runtime\" @typify_rt,\n  \"moonbitlang/core/json\",\n}\n\nwarnings = \"-unused_value-unused_package\"\n\n// Generated code is compared with the generator's output as is.\nformatter = { \"ignore\": [ \"types.mbt\" ] }\n",
    )
    // A compile-only fixture gets no dispatch entries, so nothing in the
    // suite package references it; importing it only warns as unused.
    if !compile_only {
      imports.push("  \"bobzhang/typify/\{base}/\{pkg}\",")
    }
    for pair in space.entries() {
      let rust_name = match pair.1.details {
        Struct(d) => Some(d.name)
        Enum(d) => Some(d.name)
        Newtype(d) => Some(d.name)
        _ => None
      }
      guard rust_name is Some(rust_name) && !compile_only else { continue }
      let mbt_name = @moonbit.type_name_of(space, pair.0)
      dispatch.write_string(
        "    (\"\{name}\", \"\{rust_name}\") => run(input, @\{pkg}.\{mbt_name}::from_json_str, @\{pkg}.\{mbt_name}::to_json_string)\n",
      )
    }
  }
  dispatch.write_string("    _ => \"NOTYPE\"\n  }\n}\n")
  write("\{base}/dispatch.mbt", dispatch.to_string())
  write(
    "\{base}/moon.pkg",
    "import {\n  \"bobzhang/typify/runtime\" @typify_rt,\n  \"moonbitlang/x/fs\",\n\{imports.join("\n")}\n}\n",
  )
}

///|
/// The fixture suite (conformance/moonbit).
fn fixture_suite() -> Array[
  (String, @schema.RootSchema, @typify.TypeSpaceSettings, Bool),
] {
  fixtures().map(f => {
    let (name, path, settings, everything) = f
    let root = @schema.RootSchema::from_json_str(read(path)) catch {
      e => abort("\{name}: \{e}")
    }
    let root = if everything {
      let metadata = root.schema.metadata.unwrap_or(@schema.Metadata::default())
      {
        ..root,
        schema: {
          ..root.schema,
          metadata: Some({ ..metadata, title: Some("Everything"), }),
        },
      }
    } else {
      root
    }
    (name, root, settings, name == "vega")
  })
}

///|
/// Random schemas upstream converts successfully (the first `limit` of
/// tests/oracle/typify-random/cases.jsonl-style `path`): writes the suite to
/// conformance/random, with each schema in `schemas/<name>.json` and
/// upstream's tokens in `tokens/<name>.tokens` for the Rust harness.
fn random_suite(
  path : String,
  limit : Int,
) -> Array[(String, @schema.RootSchema, @typify.TypeSpaceSettings, Bool)] {
  let out = []
  // Optionally restrict to the schemas whose upstream Rust compiles.
  let keep = Some(read_keep("conformance/random/keep.txt")) catch { _ => None }
  for
    dir in [
      "conformance/random", "conformance/random/schemas", "conformance/random/tokens",
    ] {
    @fs.create_dir(dir) catch {
      _ => ()
    }
  }
  for i, line in read(path).split("\n").map(l => l.to_owned()).collect() {
    if out.length() >= limit {
      break
    }
    let parsed = @serde_json.parse(line) catch { _ => continue }
    guard parsed is Object(case) else { continue }
    guard case.get("tokens") is Some(String(tokens)) &&
      case.get("types") is Some(String(types)) &&
      case.get("schema") is Some(schema) else {
      continue
    }
    let name = "r\{i}"
    if keep is Some(names) && !names.contains(name) {
      continue
    }
    let root = @schema.RootSchema::from_json_str(schema.to_string()) catch {
      e => abort("\{name}: \{e}")
    }
    let space = @typify.TypeSpace::new(@typify.TypeSpaceSettings::default())
    ignore(space.add_root_schema(root) catch { _ => continue })
    if recursive_flatten(space) {
      continue
    }
    write("conformance/random/schemas/\{name}.json", schema.to_string())
    write("conformance/random/tokens/\{name}.tokens", tokens)
    write("conformance/random/tokens/\{name}.types", types)
    out.push((name, root, @typify.TypeSpaceSettings::default(), false))
  }
  out
}

///|
/// Whether a struct flattens itself through a chain of flattened fields
/// (possibly via `Option`, `Box`, newtypes and untagged enums). serde's
/// nested `FlatMapSerializer` types then never end, and rustc rejects the
/// upstream Rust (E0275), so such schemas are left out of the suite.
fn recursive_flatten(space : @typify.TypeSpace) -> Bool {
  let get = (id : @typify.TypeId) => space.id_to_entry.get(id)
  // The structs whose flattened fields are reached when `id` is flattened.
  fn targets(
    id : @typify.TypeId,
    out : Array[@typify.TypeId],
    seen : Array[@typify.TypeId],
  ) -> Unit {
    if seen.contains(id) {
      return
    }
    seen.push(id)
    guard get(id) is Some(e) else { return }
    match e.details {
      Struct(_) => out.push(id)
      Option(inner) | Box(inner) => targets(inner, out, seen)
      Newtype(n) => targets(n.type_id, out, seen)
      Enum(d) if d.tag_type is Untagged =>
        for v in d.variants {
          match v.details {
            Item(t) => targets(t, out, seen)
            Struct(props) =>
              for p in props {
                if p.rename is Flatten {
                  targets(p.type_id, out, seen)
                }
              }
            _ => ()
          }
        }
      _ => ()
    }
  }
  let edges : Map[@typify.TypeId, Array[@typify.TypeId]] = Map([])
  for pair in space.entries() {
    if pair.1.details is Struct(d) {
      let out = []
      for p in d.properties {
        if p.rename is Flatten {
          targets(p.type_id, out, [])
        }
      }
      edges[pair.0] = out
    }
  }
  // Cycle detection (0 = unvisited, 1 = on the stack, 2 = done).
  let state : Map[@typify.TypeId, Int] = Map([])
  fn visit(id : @typify.TypeId) -> Bool {
    match state.get(id) {
      Some(1) => return true
      Some(_) => return false
      None => ()
    }
    state[id] = 1
    for next in edges.get(id).unwrap_or([]) {
      if visit(next) {
        return true
      }
    }
    state[id] = 2
    false
  }
  edges.keys().any(visit)
}

///|
fn strict_mode() -> Bool {
  @env.get_env_vars().get("CONFORMANCE_STRICT") is Some("1")
}

///|
fn read_keep(path : String) -> Array[String] raise {
  @fs.read_file_to_string(path)
  .split("\n")
  .filter(l => !l.is_empty())
  .map(l => l.to_owned())
  .collect()
}

///|
fn main {
  let args = @env.args()
  if args.length() >= 3 && args[1] == "random" {
    let limit = if args.length() >= 4 {
      @string.parse_int(args[3]) catch {
        _ => 200
      }
    } else {
      200
    }
    let suite = random_suite(args[2], limit)
    generate_suite("conformance/random", suite)
    // The harness: shared with conformance/moonbit, reading cases from
    // conformance/random/cases.
    let harness = read("conformance/moonbit/harness.mbt").replace_all(
      old="conformance/cases/",
      new="conformance/random/cases/",
    )
    let start = harness.find("///|\nlet fixture_names").unwrap()
    write(
      "conformance/random/harness.mbt",
      harness.unsafe_substring(start=0, end=start),
    )
    write(
      "conformance/random/names.mbt",
      "///|\nlet fixture_names : Array[String] = [\n\{suite.map(s => "  \"\{s.0}\",").join("\n")}\n]\n",
    )
    write(
      "conformance/random/random_wbtest.mbt",
      read("conformance/moonbit/conformance_wbtest.mbt"),
    )
    println("\{suite.length()} random schemas")
    return
  }
  generate_suite("conformance/moonbit", fixture_suite())
}
