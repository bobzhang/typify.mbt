///|
test "differential: heck 0.5.0" {
  for case in oracle_cases {
    let (input, pascal, snake, kebab) = case
    assert_eq(@heck.to_pascal_case(input), pascal, msg="pascal \{input}")
    assert_eq(@heck.to_snake_case(input), snake, msg="snake \{input}")
    assert_eq(@heck.to_kebab_case(input), kebab, msg="kebab \{input}")
  }
}
