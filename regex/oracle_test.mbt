///|
test "differential: regress 0.12.0" {
  let failures = []
  for case in regex_cases {
    let (pattern, subject, expected) = case
    let got = try @regex.Regex::new(pattern) catch {
      e => "ERR: \{e}"
    } noraise {
      re =>
        match re.find(subject) {
          None => "NONE"
          Some(m) => "\{m.start}..\{m.end}"
        }
    }
    if got != expected {
      failures.push(
        "\{pattern.escape()} on \{subject.escape()}: want \{expected}, got \{got}",
      )
    }
  }
  if !failures.is_empty() {
    let shown = failures.length().min(20)
    let head = failures[:shown].to_owned().join("\n")
    fail("\{failures.length()} mismatches:\n\{head}")
  }
}
