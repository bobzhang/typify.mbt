///|
let schemars_fixture_names : Array[String] = [
  "github.json", "vega.json", "arrays-and-tuples.json", "deny-list.json", "extraneous-enum.json",
  "flatten-default.json", "id-or-name.json", "maps.json", "merged-schemas.json",
  "more_types.json", "multiple-instance-types.json", "noisy-types.json", "property-pattern.json",
  "reflexive.json", "rust-collisions.json", "simple-types.json", "string-enum-with-default.json",
  "type-with-modified-generation.json", "types-with-defaults.json", "types-with-more-impls.json",
  "untyped-enum-with-null.json", "various-enums.json", "x-rust-type.json",
]

///|
test "differential: schemars 0.8.22 on random documents" {
  let failures = []
  for case in schemars_cases {
    let (input, expected) = case
    let got = try @schema.RootSchema::from_json_str(input) catch {
      _ => "ERR"
    } noraise {
      root => root.to_value().to_string()
    }
    if got != expected {
      failures.push("\{input}\n  want: \{expected}\n  got:  \{got}")
    }
  }
  if !failures.is_empty() {
    let shown = failures.length().min(10)
    let head = failures[:shown].to_owned().join("\n")
    fail("\{failures.length()} mismatches:\n\{head}")
  }
}

///|
test "differential: schemars 0.8.22 on upstream fixtures" {
  for name in schemars_fixture_names {
    let dir = if name is ("github.json" | "vega.json") {
      "impl"
    } else {
      "schemas"
    }
    let input = @fs.read_file_to_string("tests/upstream/\{dir}/\{name}")
    let expected = @fs.read_file_to_string("tests/oracle/schemars/\{name}")
    let got = @schema.RootSchema::from_json_str(input).to_value().to_string()
    assert_true(got == expected, msg="fixture \{name}")
  }
}
