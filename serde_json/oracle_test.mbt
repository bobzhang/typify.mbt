///|
test "differential: serde_json parse and print" {
  for case in parse_cases {
    let (input, compact, pretty) = case
    let (got_compact, got_pretty) = try @serde_json.parse(input) catch {
      e => ("ERR: \{e}", "")
    } noraise {
      v => (v.to_string(), v.to_string_pretty())
    }
    assert_eq(got_compact, compact, msg="compact: \{input}")
    assert_eq(got_pretty, pretty, msg="pretty: \{input}")
  }
}

///|
test "differential: ryu float formatting" {
  for case in float_cases {
    let (bits, text) = case
    let d = bits.reinterpret_as_double()
    assert_eq(@serde_json.format_f64(d), text, msg="bits \{bits}")
  }
}
