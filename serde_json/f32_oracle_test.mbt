///|
test "differential: zmij f32 formatting" {
  for case in f32_cases {
    let (bits, text) = case
    let f = Float::reinterpret_from_uint(bits)
    assert_eq(@serde_json.format_f32(f), text, msg="bits \{bits}")
  }
}
